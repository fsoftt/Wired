<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Wired.App.Views.QueuePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:Wired.App.Localization"
    xmlns:controls="clr-namespace:Wired.App.Controls"
    xmlns:vm="clr-namespace:Wired.Presentation.ViewModels;assembly=Wired.Presentation"
    x:DataType="vm:QueueViewModel"
    Shell.PresentationMode="ModalAnimated"
    Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="0,12,0,0">

        <!-- Top bar -->
        <Grid Padding="12,0,20,0" ColumnDefinitions="Auto,*,Auto">
            <ImageButton Source="ic_chevron_down.png" Clicked="OnCloseClicked" />
            <Label Grid.Column="1" Text="{l:Translate Queue_Title}" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            <Button
                Grid.Column="2"
                Text="{l:Translate Queue_Clear}"
                IsVisible="{Binding HasUpcoming}"
                Style="{StaticResource SecondaryPill}"
                HeightRequest="36"
                Padding="14,0"
                FontSize="13"
                Command="{Binding ClearCommand}" />
        </Grid>

        <!-- Now playing -->
        <Border Grid.Row="1" IsVisible="{Binding HasCurrent}" Margin="20,16,20,8" Padding="12" Style="{StaticResource Card}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <controls:Artwork Source="{Binding Current.ThumbnailUrl}" WidthRequest="56" HeightRequest="56" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                    <Label Text="{l:Translate Queue_NowPlayingHeader}" FontSize="11" CharacterSpacing="1.2" TextColor="{StaticResource Accent}" FontFamily="OpenSansSemibold" />
                    <Label Text="{Binding Current.Title}" Style="{StaticResource TrackTitle}" />
                    <Label Text="{Binding Current.Artist}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Label Grid.Row="2" Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="20,8" />

        <!-- Upcoming: drag the handle to reorder, swipe to remove -->
        <CollectionView
            x:Name="UpcomingList"
            Grid.Row="3"
            ItemsSource="{Binding Upcoming}"
            CanReorderItems="True"
            ReorderCompleted="OnReorderCompleted">
            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:QueueEntryViewModel">
                    <SwipeView BackgroundColor="Transparent">
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem Text="{l:Translate Common_Remove}" IconImageSource="ic_delete.png" BackgroundColor="{StaticResource Danger}" Command="{Binding RemoveCommand}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <controls:Pressable Command="{Binding PlayCommand}" BackgroundColor="{StaticResource Background}">
                            <Grid Padding="20,8,12,8" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                <controls:Artwork Source="{Binding ThumbnailUrl}" WidthRequest="48" HeightRequest="48" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Title}" Style="{StaticResource TrackTitle}" MaxLines="1" />
                                    <Label Text="{Binding Artist}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <ImageButton Grid.Column="2" Source="ic_close.png" Opacity="0.5" Command="{Binding RemoveCommand}" />
                                <Image Grid.Column="3" Source="ic_drag.png" WidthRequest="22" HeightRequest="22" Opacity="0.45" VerticalOptions="Center" />
                            </Grid>
                        </controls:Pressable>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
