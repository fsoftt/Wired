<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Wired.App.Controls.Artwork"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Gradient placeholder with a note; the remote thumbnail covers it once loaded. -->
    <Border
        x:Name="Card"
        Style="{StaticResource Artwork}">
        <Grid>
            <Image
                x:Name="Placeholder"
                Source="ic_music_note.png"
                Opacity="0.85"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
            <Image
                x:Name="Thumbnail"
                Aspect="AspectFill" />
        </Grid>
    </Border>

</ContentView>
