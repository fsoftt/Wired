<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Wired.App.Controls.MiniPlayerView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Wired.App.Controls"
    xmlns:vm="clr-namespace:Wired.Presentation.ViewModels;assembly=Wired.Presentation"
    x:DataType="vm:PlayerViewModel"
    IsVisible="{Binding HasTrack}">

    <Border
        Margin="12,0,12,10"
        Padding="10,10,6,0"
        Background="{StaticResource SurfaceRaisedBrush}"
        Stroke="{StaticResource OutlineBrush}"
        StrokeShape="RoundRectangle 20">
        <Border.Shadow>
            <Shadow Brush="{StaticResource PrimaryBrush}" Opacity="0.35" Radius="24" Offset="0,6" />
        </Border.Shadow>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenNowPlayingCommand}" />
        </Border.GestureRecognizers>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
            <controls:Artwork
                Source="{Binding ThumbnailUrl}"
                CornerRadius="10"
                WidthRequest="46"
                HeightRequest="46" />

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" MaxLines="1" LineBreakMode="TailTruncation" />
                <Label Text="{Binding Artist}" Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <Grid Grid.Column="2">
                <ImageButton Source="ic_play.png" IsVisible="{Binding ShowPlay}" Command="{Binding TogglePlayPauseCommand}" />
                <ImageButton Source="ic_pause.png" IsVisible="{Binding ShowPause}" Command="{Binding TogglePlayPauseCommand}" />
                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" WidthRequest="24" HeightRequest="24" />
            </Grid>

            <ImageButton Grid.Column="3" Source="ic_next.png" Command="{Binding NextCommand}" />

            <ProgressBar
                Grid.Row="1"
                Grid.ColumnSpan="4"
                Margin="0,10,4,0"
                HeightRequest="3"
                Progress="{Binding Progress}" />
        </Grid>
    </Border>

</ContentView>
