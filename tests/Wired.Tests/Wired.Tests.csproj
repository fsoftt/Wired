<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Same as trimmed Release apps (Android): storage must not rely on reflection-based JSON. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tiny generated audio/image files (1 s of tone, 8x8 image) for tag tests. -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wired.Core\Wired.Core.csproj" />
    <ProjectReference Include="..\..\src\Wired.Infrastructure\Wired.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Wired.Presentation\Wired.Presentation.csproj" />
  </ItemGroup>

</Project>
